{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "lib": ["DOM", "ES2021"],
        "types": [],
        "useUnknownInCatchVariables": true,
        "strictBindCallApply": true
    },
    "include": ["**/*.ts"],
    "exclude": ["*_snippet.ts"]
}
