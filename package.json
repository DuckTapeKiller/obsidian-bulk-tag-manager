{
    "name": "bulk-tag-manager",
    "version": "1.0.5",
    "description": "Bulk convert all tags in your vault to lowercase, verify stats, and generate tag lists.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit --skipLibCheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node test/strip-inline-tags.test.mjs",
        "lint:strict": "eslint --config eslint.strict.mjs ."
    },
    "keywords": [],
    "author": "DuckTapeKiller",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@eslint/json": "^0.14.0",
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "esbuild": "^0.24.2",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "globals": "^17.0.0",
        "obsidian": "^1.7.2",
        "prettier": "^3.8.4",
        "tslib": "^2.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.52.0"
    }
}
